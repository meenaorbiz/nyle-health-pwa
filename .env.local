# Target Switcher: 'local' (Next.js API routes) or 'cloud' (GCP Microservices)
NEXT_PUBLIC_API_TARGET=local
NEXT_PUBLIC_GCP_API_URL=https://api.nylehealth.com

# GCP Cloud SQL PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/nyle_health_db

# AI Engine API Keys
SARVAM_API_KEY=your_sarvam_ai_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp / Gupshup Messaging
GUPSHUP_APP_NAME=nyle_health
GUPSHUP_API_KEY=your_gupshup_key_here
